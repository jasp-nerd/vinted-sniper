# Copy this to .env and edit. Every setting is optional except where noted.
# Full reference: docs/configuration.md

# --- Where things are stored -------------------------------------------------------
# Inside Docker this is already /data/app.db; leave it alone unless you know why.
# VINTED_SNIPER_DB_PATH=./data/app.db

# Delete stored listings after this many days. Does not cause anything to be re-sent.
# VINTED_SNIPER_ITEM_RETENTION_DAYS=30

# Keep each listing's raw API payload. Useful when debugging, but it stores more seller
# data than notifications need, so it is off by default.
# VINTED_SNIPER_KEEP_RAW_JSON=false


# --- Telegram ----------------------------------------------------------------------
# Talk to @BotFather on Telegram to create a bot; it gives you a token like
# 123456:AAxxxx. Setting this turns on Telegram delivery and the pairing bot.
# VINTED_SNIPER_TELEGRAM_BOT_TOKEN=


# --- Web dashboard -----------------------------------------------------------------
# On by default at http://localhost:8000. Set this to false if you only use the CLI.
# VINTED_SNIPER_WEB_ENABLED=true

# No password by default, which is fine while it only listens on localhost. Set a token
# before exposing the dashboard any further — it shows your webhook URLs and chat ids.
# Generate one with: openssl rand -hex 32
# VINTED_SNIPER_WEB_AUTH_TOKEN=

# Localhost only. The container sets 0.0.0.0 internally; the compose file is what limits
# who can reach the published port.
# VINTED_SNIPER_WEB_HOST=127.0.0.1
# VINTED_SNIPER_WEB_PORT=8000


# --- How often to check ------------------------------------------------------------
# Seconds between checks for a new search. Per-search overrides live in the app itself.
# Below 10 is ignored: Vinted's own catalog lags further behind than that, so checking
# faster finds nothing sooner and does get you blocked.
# VINTED_SNIPER_POLL_DEFAULT_INTERVAL_S=60

# Ignore listings whose photo is older than this many minutes. Stops a restart or a slow
# first check from replaying yesterday's catalog.
# VINTED_SNIPER_FRESHNESS_WINDOW_MIN=20

# What a brand-new search does on its first check:
#   silent  notify nothing, just remember what is already there (default)
#   newest  send exactly one listing, so you can confirm delivery works
# VINTED_SNIPER_FIRST_RUN_MODE=silent


# --- Staying unblocked -------------------------------------------------------------
# Start a fresh session after this many minutes. Blocks track how long a session has been
# alive more than how fast it is used, so replacing them on a timer helps.
# VINTED_SNIPER_SESSION_ROTATE_MINUTES=60

# Present a real browser's TLS fingerprint instead of Python's. Only worth turning on if
# you are getting blocked while the same search loads fine in your browser. Needs the
# image built with the 'impersonate' extra.
# VINTED_SNIPER_HTTP_IMPERSONATE=false

# A text file of proxy URLs, one per line. Off by default and rarely needed.
# VINTED_SNIPER_PROXY_FILE=

# How long to wait for Vinted before giving up on a single request.
# VINTED_SNIPER_REQUEST_TIMEOUT_S=15


# --- Noticing when something is wrong ----------------------------------------------
# How many checks with no new listing before a search is treated as stuck. It is only
# treated as stuck if other searches on the same site are still finding things.
# VINTED_SNIPER_WATCHDOG_STALE_CYCLES=10

# What to do about it: warn, or also start a fresh session (default).
# VINTED_SNIPER_WATCHDOG_ACTION=rotate

# Give up on an undelivered notification after this long. An alert about a listing from
# two hours ago is not worth sending.
# VINTED_SNIPER_OUTBOX_EXPIRY_MINUTES=60


# --- Logging -----------------------------------------------------------------------
# VINTED_SNIPER_LOG_LEVEL=INFO
# console while you are watching, json when something else is collecting it.
# VINTED_SNIPER_LOG_FORMAT=console


# --- Working on the code ------------------------------------------------------------
# 'mock' replays recorded responses from disk instead of calling Vinted, so you can
# develop and demo offline. Requires a scenario directory.
# VINTED_SNIPER_FETCH_MODE=live
# VINTED_SNIPER_MOCK_SCENARIO_DIR=
